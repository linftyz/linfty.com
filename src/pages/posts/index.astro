---
import PostPreview from "@/components/blocks/PostPreview.astro";
import Layout from "@/layouts/Layout.astro";
import { getPosts } from "@/utils/post";
import site from "@/config/site";

const posts = await getPosts();
const years = [
  ...new Set(posts.map((post) => post.data.createdAt.getFullYear())),
];
---

<Layout
  title={site.labels.postsTitle}
  description={`${site.labels.postsDescription} · 共 ${posts.length} ${site.labels.postsCountSuffix}`}
>
  <div class="mx-auto max-w-2xl p-8 md:p-12" data-pagefind-body>
    <header class="mb-12">
      <h1 class="mb-4 text-3xl font-bold tracking-tight">
        {site.labels.postsTitle}
      </h1>
      <p class="text-sm font-light text-muted-foreground">
        {site.labels.postsDescription} · 共 {posts.length}
        {site.labels.postsCountSuffix}
      </p>
    </header>

    <div class="space-y-16">
      {
        years.map((year) => (
          <section class="relative">
            <h2 class="year text-4xl tracking-tighter text-muted-foreground tabular-nums">
              {year}
            </h2>
            <div class="space-y-8">
              {posts
                .filter((post) => post.data.createdAt.getFullYear() === year)
                .map((post) => (
                  <PostPreview post={post} />
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .year {
    -webkit-text-fill-color: #0000;
    -webkit-text-stroke: thin;
  }
</style>
