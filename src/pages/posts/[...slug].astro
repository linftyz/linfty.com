---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TableOfContents from "@/components/post/TableOfContents.astro";
import { fullDate } from "@/lib/format";
import {
  categoryName,
  getPosts,
  getTaxonomies,
  readingTime,
} from "@/lib/posts";
export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      minutes: readingTime(post.body ?? ""),
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

const { post, minutes, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, tags, cover } = post.data;
const { categories, tags: tagMap } = await getTaxonomies();
const category = categoryName(post, categories);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  ogImage={cover}
>
  <article>
    <header class="mb-6.5">
      <h1 class="m-0 font-serif text-[1.5rem] leading-[1.7] font-semibold tracking-[3px] text-heading">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2.5 text-[.76rem] tracking-[1px] text-muted-foreground">
        <time datetime={date.toISOString()}>{fullDate(date)}</time>
        {category && (
          <a
            href={`/categories/${post.data.category!.id}`}
            class="transition-colors hover:text-accent"
          >
            · {category}
          </a>
        )}
        <span>· {minutes} 分钟阅读</span>
        {updated && <span>· 更新于 {fullDate(updated)}</span>}
      </div>
    </header>

    {cover && (
      <img
        src={cover}
        alt={title}
        class="mb-8 aspect-[2/1] max-h-[360px] w-full overflow-hidden rounded-md border border-border-soft object-cover object-top saturate-[.92]"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="text-[.72rem] tracking-[2px] text-muted-foreground">
          标签
        </span>
        {tags.map((ref) => (
          <a
            href={`/tags/${ref.id}`}
            class="text-[.76rem] tracking-[1px] text-muted-foreground transition-colors hover:text-accent"
          >
            #{tagMap.get(ref.id)?.data.name ?? ref.id}
          </a>
        ))}
      </div>
    )}
  </article>

  <nav
    class="my-10 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-dashed border-border-soft py-5 max-[561px]:grid-cols-1"
    aria-label="相邻文章"
  >
    <div class="text-[.76rem] leading-[1.8]">
      <span class="block text-[.72rem] tracking-[2px] text-muted-foreground">
        上一篇
      </span>
      {older ? (
        <a
          href={`/posts/${older.id}`}
          class="text-foreground transition-colors hover:text-accent"
        >
          {older.data.title}
        </a>
      ) : (
        <span class="text-muted-foreground">没有更早的文章了</span>
      )}
    </div>
    <div class="text-right text-[.76rem] leading-[1.8] max-[561px]:text-left">
      <span class="block text-[.72rem] tracking-[2px] text-muted-foreground">
        下一篇
      </span>
      {newer ? (
        <a
          href={`/posts/${newer.id}`}
          class="text-foreground transition-colors hover:text-accent"
        >
          {newer.data.title}
        </a>
      ) : (
        <span class="text-muted-foreground">没有更新的文章了</span>
      )}
    </div>
  </nav>
</BaseLayout>

<script>
  import "@/utils/client/embedded-media";
</script>
