---
import { fullDate } from "@/lib/format";

export interface PostCardProps {
  title: string;
  href: string;
  date: Date;
  category?: string;
  categoryHref?: string;
  excerpt: string;
  readingTime?: number;
  cover?: string;
}

const {
  title,
  href,
  date,
  category,
  categoryHref,
  excerpt,
  readingTime,
  cover,
} = Astro.props;
---

<li class="border-b border-dashed border-border-soft py-[23px] first:pt-0">
  <div
    class:list={[
      cover &&
        "grid grid-cols-[minmax(0,1fr)_168px] items-center gap-[22px] max-[561px]:grid-cols-1",
    ]}
  >
    <div class="min-w-0">
      <div class="mb-2.5 flex flex-wrap items-baseline gap-x-[11px]">
        <h2 class="m-0 font-serif text-[1.08rem] font-semibold leading-[1.6]">
          <a
            href={href}
            class="border-b border-border tracking-[.08em] text-heading transition-colors hover:border-accent hover:text-accent"
          >
            {title}
          </a>
        </h2>
        {category &&
          (categoryHref ? (
            <a
              href={categoryHref}
              class="text-[.76rem] tracking-[1px] text-muted-foreground transition-colors hover:text-accent"
            >
              · {category}
            </a>
          ) : (
            <span class="text-[.76rem] tracking-[1px] text-muted-foreground">
              · {category}
            </span>
          ))}
      </div>

      <p class="text-justify text-[.91rem] leading-[1.9] tracking-[.035em] text-foreground line-clamp-3">
        {excerpt}
      </p>

      <div class="mt-[7px] flex items-center justify-between gap-4 text-[.76rem] tracking-[.5px] text-muted-foreground max-[561px]:items-start max-[561px]:text-[.72rem]">
        <span>
          <time datetime={date.toISOString()}>{fullDate(date)}</time>
          {readingTime && ` · ${readingTime} 分钟阅读`}
        </span>
        <a
          href={href}
          class="shrink-0 border-b border-transparent tracking-[1px] transition-colors hover:border-accent-strong hover:text-accent-strong"
        >
          阅读全文
        </a>
      </div>
    </div>

    {cover && (
      <div class="overflow-hidden rounded-md max-[561px]:order-first">
        <img
          src={cover}
          alt={title}
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full rounded-md border border-border-soft object-cover saturate-[.88]"
        />
      </div>
    )}
  </div>
</li>
