---
import { themeConfig } from "@/config";
import ThemeToggle from "../layout/ThemeToggle.astro";
import Logo from "./Logo.astro";

const { nav } = themeConfig;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, "") || "/";
  return target === "/" ? pathname === "/" : pathname.startsWith(target);
};
---

<aside class="sticky top-24 flex h-[calc(100vh-10rem)] flex-col items-end pt-[100px] max-[861px]:hidden">
  <Logo />

  <nav class="flex w-full flex-col items-end gap-[15px]" aria-label="主导航">
    {nav.map((item) => (
      <a
        href={item.href}
        aria-current={isCurrent(item.href) ? "page" : undefined}
        class:list={[
          "inline-block rounded-lg py-[3px] pr-1.5 pl-3 text-[1.02rem] leading-normal tracking-[6px] transition-colors",
          isCurrent(item.href)
            ? "bg-accent text-background"
            : "text-foreground hover:bg-accent/12 hover:text-accent",
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mt-auto py-[22px]">
    <ThemeToggle />
  </div>
</aside>
