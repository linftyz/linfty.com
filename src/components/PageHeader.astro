---
export interface PageHeaderProps {
  title: string;
  intro?: string;
  stats?: string[];
}

const { title, intro, stats } = Astro.props;
---

<header class="mb-11.5">
  <h1 class="m-0 mb-2 font-serif text-[1.55rem] font-semibold tracking-[3px] text-heading">
    {title}
  </h1>
  {intro && (
    <p class="text-[0.86rem] leading-[1.85] tracking-[1px] text-muted-foreground">
      {intro}
    </p>
  )}
  {stats && stats.length > 0 && (
    <div class="mt-5.5 flex flex-wrap gap-x-4 gap-y-1 text-[0.8rem] tracking-[1px] text-muted-foreground">
      {stats.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  )}
</header>
