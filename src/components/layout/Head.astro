---
import site from "@/config/site";
import type { HeadProps } from "@/types";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

type Props = HeadProps;

const {
  title,
  description,
  image = site.ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  section,
  tags = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const resolvedDescription = description.trim() || site.meta.description;

const toISOString = (value?: Date | string) => {
  if (!value) return undefined;

  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
};

const publishedTimeISO = toISOString(publishedTime);
const modifiedTimeISO = toISOString(modifiedTime) || publishedTimeISO;
const twitterHandle = site.meta.twitterHandle.trim().replace(/^@/, "");
const structuredData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: resolvedDescription,
        image: imageURL.toString(),
        mainEntityOfPage: canonicalURL.toString(),
        ...(publishedTimeISO ? { datePublished: publishedTimeISO } : {}),
        ...(modifiedTimeISO ? { dateModified: modifiedTimeISO } : {}),
        ...(section ? { articleSection: section } : {}),
        ...(tags.length > 0 ? { keywords: tags } : {}),
        author: {
          "@type": "Person",
          name: site.meta.author,
        },
        publisher: {
          "@type": "Person",
          name: site.meta.author,
          image: new URL(site.meta.logo, Astro.site).toString(),
        },
      }
    : undefined;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!-- Global Metadata -->
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (() => {
      const getPreferredTheme = () => {
        try {
          const storedTheme = window.localStorage.getItem("theme");
          if (storedTheme === "dark" || storedTheme === "light") {
            return storedTheme;
          }
        } catch {
          // Ignore storage access failures and fall back to the system setting.
        }

        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const applyTheme = () => {
        document.documentElement.classList.toggle(
          "dark",
          getPreferredTheme() === "dark",
        );
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />

  <!-- Apple Touch Icon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- PWA Icons -->
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />

  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json" />

  <!-- Theme Color -->
  <meta name="theme-color" content="#3F9C87" />
  <meta name="msapplication-TileColor" content="#3F9C87" />

  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={resolvedDescription} />
  <meta name="author" content={site.meta.author} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:site_name" content={site.meta.title} />
  <meta property="og:locale" content={site.meta.lang.replace("-", "_")} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={resolvedDescription} />
  <meta property="og:image" content={imageURL} />
  {
    type === "article" && publishedTimeISO && (
      <meta property="article:published_time" content={publishedTimeISO} />
    )
  }
  {
    type === "article" && modifiedTimeISO && (
      <meta property="article:modified_time" content={modifiedTimeISO} />
    )
  }
  {
    type === "article" && section && (
      <meta property="article:section" content={section} />
    )
  }
  {
    type === "article" &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)
  }

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={resolvedDescription} />
  {
    twitterHandle && (
      <meta name="twitter:creator" content={`@${twitterHandle}`} />
    )
  }
  <meta name="twitter:image" content={imageURL} />

  {
    serializedStructuredData && (
      <script type="application/ld+json" set:html={serializedStructuredData} />
    )
  }

  <!-- RSS Link -->
  <link
    rel="alternate"
    type="application/rss+xml"
    title={site.meta.title}
    href={new URL("rss.xml", Astro.site)}
  />

  <!-- canonical url -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- font  -->
  <Font cssVariable="--font-display" preload />

  <!-- View Transtions -->
  <ClientRouter />
</head>
