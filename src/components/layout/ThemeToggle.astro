---

---

<button
  id="theme-toggle"
  type="button"
  class="relative flex h-6 w-10 items-center rounded-full bg-muted p-1 transition-colors duration-200 after:absolute after:inset-y-[-8px] after:right-0 after:left-0 after:content-[''] active:scale-[0.96]"
  title="切换主题"
  aria-label="切换主题"
>
  <div
    class="h-4 w-4 translate-x-0 rounded-full bg-background shadow-sm transition-transform duration-200 dark:translate-x-4"
  >
  </div>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    const getPreferredTheme = () => {
      try {
        const localStorageTheme = localStorage.getItem("theme") ?? "";
        if (["dark", "light"].includes(localStorageTheme)) {
          return localStorageTheme;
        }
      } catch {
        // Storage can be unavailable in private browsing or embedded contexts.
      }

      if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        return "dark";
      }
      return "light";
    };

    const setTheme = (theme: "dark" | "light", persist = false) => {
      document.documentElement.classList.toggle("dark", theme === "dark");

      if (persist) {
        try {
          window.localStorage.setItem("theme", theme);
        } catch {
          // Keep the visible theme change even if storage is unavailable.
        }
      }
    };

    const theme = getPreferredTheme() as "dark" | "light";

    setTheme(theme);

    let themeSwitchTimer: number | undefined;

    const handleToggleClick = () => {
      const element = document.documentElement;
      const nextTheme = element.classList.contains("dark") ? "light" : "dark";

      // Animate the color change, then release the class so it cannot affect
      // any other transition.
      element.classList.add("theme-switching");
      window.clearTimeout(themeSwitchTimer);
      themeSwitchTimer = window.setTimeout(() => {
        element.classList.remove("theme-switching");
      }, 320);

      setTheme(nextTheme, true);
    };

    const themeToggle = document.getElementById("theme-toggle");
    themeToggle?.addEventListener("click", handleToggleClick);
  });
</script>
