---
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
---

<button
  type="button"
  class="theme-toggle inline-flex cursor-pointer items-center border-0 bg-transparent p-2 text-muted-foreground transition-colors hover:text-accent"
  aria-label="切换主题"
>
  <Moon size={18} stroke-width={1.5} class="block dark:hidden" />
  <Sun size={18} stroke-width={1.5} class="hidden dark:block" />
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".theme-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        // 换色是瞬时的，但 color 有过渡，不禁用会闪一下旧色
        const root = document.documentElement;
        root.classList.add("theming");
        const isDark = root.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        requestAnimationFrame(() => {
          requestAnimationFrame(() => root.classList.remove("theming"));
        });
      });
    });
  });
</script>
