---

<button
  type="button"
  class="theme-toggle cursor-pointer border-0 bg-transparent p-2 text-[1.05rem] text-muted-foreground transition-colors hover:text-accent"
  aria-label="切换主题"
>
  ◐
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".theme-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        // 换色是瞬时的，但 color 有过渡，不禁用会闪一下旧色
        const root = document.documentElement;
        root.classList.add("theming");
        const isDark = root.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        requestAnimationFrame(() => {
          requestAnimationFrame(() => root.classList.remove("theming"));
        });
      });
    });
  });
</script>
