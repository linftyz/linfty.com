---
import site from "@/config/site";
import { Image } from "astro:assets";
---

<a
  href="/"
  aria-label={site.meta.title}
  class="group mb-5 flex items-center gap-3 md:mb-6"
>
  <div
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-muted text-lg font-bold text-primary-foreground md:h-10 md:w-10"
  >
    <Image
      loading={"eager"}
      src={site.meta.logo}
      alt={"站点标志"}
      width={44}
      height={44}
    />
  </div>
  <div class="min-w-0">
    <span
      data-pagefind-ignore
      class="block truncate text-base font-bold tracking-tight text-foreground transition-colors group-hover:text-primary md:text-lg"
    >
      {site.meta.title}
    </span>
    <p
      class="mt-1 hidden text-[11px] leading-snug text-muted-foreground/80 md:block"
    >
      {site.meta.description}
    </p>
  </div>
</a>
