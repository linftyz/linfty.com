---
import { themeConfig } from "@/config";
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/layout/BaseHead.astro";
import type { BaseHeadProps } from "@/types";
import "@/styles/global.css";
import SideNav from "@/components/nav/SideNav.astro";
import MobileBar from "@/components/nav/MobileBar.astro";
import SiteFooter from "@/components/SiteFooter.astro";

type Props = BaseHeadProps;

const language = themeConfig.site.lang || "en-US";
---

<html lang={language}>
  <head>
    <BaseHead {...Astro.props} />
    <ClientRouter />
  </head>
  <body class="bg-background font-sans text-[16px] text-foreground">
    <MobileBar />
    <div class="mx-auto grid w-full max-w-[1100px] grid-cols-[220px_minmax(0,760px)] justify-center gap-14 px-8 pt-24 pb-12 max-[861px]:block max-[861px]:px-4 max-[861px]:pt-[84px] max-[861px]:pb-10">
      <SideNav />
      <main class="min-w-0 self-start rounded-lg border border-card-border bg-card p-7.5 outline-none max-[561px]:px-4 max-[561px]:py-5">
        <slot />
        <SiteFooter />
      </main>
    </div>
  </body>
</html>
